modules = ["python-3.11", "python3", "postgresql-16"]
[agent]
integrations = ["python_gemini:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg-full", "glibcLocales"]

[deployment]
deploymentTarget = "autoscale"
run = ["streamlit", "run", "app.py", "--server.port", "5000"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Excel Mock Interviewer"

[[workflows.workflow]]
name = "Excel Mock Interviewer"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "streamlit run app.py --server.port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33843
externalPort = 3000

[[ports]]
localPort = 35329
externalPort = 3002

[[ports]]
localPort = 44239
externalPort = 3001
